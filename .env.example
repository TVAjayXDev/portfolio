# =============================================================================
# ENVIRONMENT VARIABLES SPECIFICATION
# =============================================================================
# Format:
# - Scope: [PUBLIC] (prefixed with NEXT_PUBLIC_, exposed in client bundles)
#          [SERVER-ONLY] (must NEVER be exposed to the browser or client-side code)
# - Targets: [Local] (.env.local) | [Vercel] (Project Settings > Environment Variables)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Supabase Public Project URL
# Scope:   [PUBLIC]
# Targets: Local (.env.local), Vercel (Production / Preview / Development)
# Purpose: Base URL for Supabase API requests and CDN asset access.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# -----------------------------------------------------------------------------
# 2. Supabase Anonymous API Key
# Scope:   [PUBLIC]
# Targets: Local (.env.local), Vercel (Production / Preview / Development)
# Purpose: Anonymous browser key used for public data queries governed by RLS.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# 3. Supabase Service Role Secret Key
# Scope:   [SERVER-ONLY] - CRITICAL: NEVER expose to client or NEXT_PUBLIC_ vars
# Targets: Local (.env.local), Vercel (Production / Preview / Development)
# Purpose: Privileged server operations (rate limiting, contact form inserts, storage cleanup).
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# -----------------------------------------------------------------------------
# 4. Strict Single Admin Email Address
# Scope:   [SERVER-ONLY]
# Targets: Local (.env.local), Vercel (Production / Preview / Development)
# Purpose: Strict admin membership verification in auth checks and middleware.
# -----------------------------------------------------------------------------
ADMIN_EMAIL=tvajay0@gmail.com

# -----------------------------------------------------------------------------
# 5. Contact IP Salt
# Scope:   [SERVER-ONLY] - CRITICAL: No fallback in production
# Targets: Local (.env.local), Vercel (Production / Preview / Development)
# Purpose: Secret salt for SHA-256 hashing visitor IPs for rate limiting without storing raw IPs.
# -----------------------------------------------------------------------------
CONTACT_IP_SALT=your-high-entropy-random-salt-here

# -----------------------------------------------------------------------------
# 6. Resend Email Delivery API Key
# Scope:   [SERVER-ONLY]
# Targets: Local (.env.local), Vercel (Production / Preview / Development)
# Purpose: Dispatching real-time email notifications for contact submissions.
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here

# -----------------------------------------------------------------------------
# 7. Canonical Site URL
# Scope:   [PUBLIC]
# Targets: Local (.env.local), Vercel (Production / Preview / Development)
# Purpose: Used as metadataBase for canonical links, sitemap, robots.txt, and Open Graph previews.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://tvajay.dev

# -----------------------------------------------------------------------------
# 8. GitHub Personal Access Token (Optional)
# Scope:   [SERVER-ONLY]
# Targets: Local (.env.local), Vercel (Production / Preview / Development)
# Purpose: Increases rate limits on GitHub REST API queries for repository cards.
# -----------------------------------------------------------------------------
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# 9. Cron Secret for Keep-Alive Endpoint
# Scope:   [SERVER-ONLY]
# Targets: Local (.env.local), Vercel (Production / Preview / Development)
# Purpose: Secures the /api/keepalive ping against unauthorized execution.
#          Automatically sent by Vercel Cron jobs via Authorization: Bearer <CRON_SECRET>.
# -----------------------------------------------------------------------------
CRON_SECRET=your-random-32-char-cron-secret-here
